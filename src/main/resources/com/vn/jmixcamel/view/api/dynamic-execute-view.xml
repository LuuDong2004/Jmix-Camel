<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dynamicExecuteView.title">
    <layout classNames="p-m" spacing="true" width="100%">

        <span text="Nhập cấu hình → sinh Camel YAML/XML DSL → thực thi. Click các nút bên dưới để mở popup chỉnh sửa."/>

        <hbox spacing="true">
            <button id="executeBtn" text="Thực thi" themeNames="primary"/>
            <button id="previewYamlBtn" text="Xem YAML"/>
            <button id="previewXmlBtn" text="Xem XML"/>
            <button id="loadSampleBtn" text="Nạp mẫu"/>
            <button id="resetBtn" text="Xoá form"/>
        </hbox>

        <split orientation="HORIZONTAL" width="100%" minHeight="44em" splitterPosition="50">

            <vbox width="100%" spacing="true">

                <h4 text="1. Input variables"/>
                <button id="editInputBtn" text="Input variables"/>

                <h4 text="2. API request"/>
                <hbox width="100%" spacing="true" alignItems="END">
                    <comboBox id="apiMethodField" label="Method" width="9em"/>
                    <textField id="apiUrlField" label="URL"
                               placeholder="http://localhost:8081/api/users/${userId}"
                               width="100%"/>
                </hbox>
                <hbox spacing="true">
                    <button id="editHeadersBtn" text="Headers"/>
                    <button id="editBodyBtn" text="Body"/>
                </hbox>

                <h4 text="3. Extract (JSONPath)"/>
                <button id="editExtractBtn" text="Extract"/>

                <h4 text="4. DB query"/>
                <formLayout width="100%">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="2"/>
                        <responsiveStep minWidth="700px" columns="4"/>
                    </responsiveSteps>
                    <comboBox id="dbEntityField" label="Entity" width="100%"/>
                    <textField id="dbOrderByField" label="Order by" width="100%"/>
                    <comboBox id="dbOrderDirField" label="Direction" width="100%"/>
                    <integerField id="dbLimitField" label="Limit" width="100%"/>
                </formLayout>
                <hbox spacing="true">
                    <button id="openSqlBtn" text="SQL parser"/>
                    <button id="editFiltersBtn" text="Filters"/>
                </hbox>

                <h4 text="5. Response template"/>
                <button id="editResponseBtn" text="Response template"/>

            </vbox>

            <vbox width="100%" spacing="true">
                <textArea id="previewArea"
                          label="Preview (YAML/XML)"
                          width="100%"
                          height="32em"
                          readOnly="true"
                          themeNames="small"/>
                <textArea id="resultArea"
                          label="Kết quả thực thi"
                          width="100%"
                          height="20em"
                          readOnly="true"
                          themeNames="small"/>
            </vbox>

        </split>

    </layout>
</view>
